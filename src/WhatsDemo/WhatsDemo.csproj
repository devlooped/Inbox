<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <GenerateDocumentationFile>false</GenerateDocumentationFile>
    <RootNamespace>WhatsDemo</RootNamespace>
    <AssemblyName>WhatsDemo</AssemblyName>
    <Description>WhatsApp companion REPL. dotnet tool install -g wd.</Description>
    <PackageId>wd</PackageId>
    <PackAsTool>true</PackAsTool>
    <PublishAot>true</PublishAot>
    <ToolCommandName>wd</ToolCommandName>
    <ToolPackageRuntimeIdentifiers>win-x64;win-arm64;linux-x64;linux-arm64;osx-x64;osx-arm64</ToolPackageRuntimeIdentifiers>
    <IsPackable>true</IsPackable>
    <NoWarn>$(NoWarn);NU5128</NoWarn>
    <RestoreSources>$(PackageOutputPath);https://api.nuget.org/v3/index.json</RestoreSources>
  </PropertyGroup>

  <!--
    Pointer (`dotnet pack`): DotnetTool v2 settings listing wd.{rid}.
    RID (`dotnet pack -r`): AOT tool plus the WhatsBox native sidecar.
    Same split as WhatsBox / the Math+Calc sample — do not suffix PackageId here;
    the SDK appends $(RuntimeIdentifier) for DotnetToolRidPackage.
  -->

  <ItemGroup>
    <PackageReference Include="QRCoder" Version="1.8.0" />
    <PackageReference Include="WhatsBox" Version="*" />
    <PackageReference Include="Readme" Version="1.2.1" PrivateAssets="all" />
  </ItemGroup>

</Project>
