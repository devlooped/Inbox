<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <PackageId>WhatsBox</PackageId>
    <RootNamespace>WhatsBox</RootNamespace>
    <AssemblyName>WhatsBox</AssemblyName>
    <Description>WhatsApp Inbox Protocol host: PackageReference WhatsBox and publish for your RID to get the native whatsbox sidecar plus the managed Inbox client.</Description>
    <IsAotCompatible>true</IsAotCompatible>
    <RuntimeIdentifiers>win-x64;win-arm64;linux-x64;linux-arm64;osx-x64;osx-arm64</RuntimeIdentifiers>
    <IsPackable>true</IsPackable>
    <InboxNativeName>whatsbox</InboxNativeName>
    <InboxNativeName Condition="$([MSBuild]::IsOSPlatform('Windows'))">whatsbox.exe</InboxNativeName>
    <InboxNativeBinary>$([System.IO.Path]::GetFullPath('$(MSBuildThisFileDirectory)$(BaseIntermediateOutputPath)native\$(InboxNativeName)'))</InboxNativeBinary>
    <NativeWhatsBoxSourceRoot>$([System.IO.Path]::GetFullPath('$(MSBuildThisFileDirectory)..\WhatsBox.Native'))</NativeWhatsBoxSourceRoot>
    <InboxIncludeNativeAfterTargets>BuildNativeWhatsBox</InboxIncludeNativeAfterTargets>
    <InboxPackNativeDependsOn>BuildWhatsBoxRidNative</InboxPackNativeDependsOn>
  </PropertyGroup>

  <!--
    Pointer (`dotnet pack`): lib/net10.0/WhatsBox.dll + runtime.json (Inbox.targets).
    RID (`dotnet pack -r`): runtimes/{rid}/native/whatsbox[.exe] from the Go sidecar.
    Not PackAsTool — a DotnetTool pointer cannot be PackageReferenced (NU1212).
  -->

  <PropertyGroup Condition="'$(RuntimeIdentifier)' != ''">
    <_WhatsBoxRidGoos Condition="$(RuntimeIdentifier.StartsWith('win-'))">windows</_WhatsBoxRidGoos>
    <_WhatsBoxRidGoos Condition="$(RuntimeIdentifier.StartsWith('linux-'))">linux</_WhatsBoxRidGoos>
    <_WhatsBoxRidGoos Condition="$(RuntimeIdentifier.StartsWith('osx-'))">darwin</_WhatsBoxRidGoos>
    <_WhatsBoxRidGoarch Condition="$(RuntimeIdentifier.EndsWith('-x64'))">amd64</_WhatsBoxRidGoarch>
    <_WhatsBoxRidGoarch Condition="$(RuntimeIdentifier.EndsWith('-arm64'))">arm64</_WhatsBoxRidGoarch>
    <InboxNativeName>whatsbox</InboxNativeName>
    <InboxNativeName Condition="$(RuntimeIdentifier.StartsWith('win-'))">whatsbox.exe</InboxNativeName>
    <InboxNativeBinary>$([System.IO.Path]::GetFullPath('$(IntermediateOutputPath)runtimes\$(RuntimeIdentifier)\native\$(InboxNativeName)'))</InboxNativeBinary>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="CliWrap" Version="3.10.5" />
    <PackageReference Include="JsonPeek" Version="1.3.0" PrivateAssets="all" />
    <PackageReference Include="JsonPoke" Version="1.3.0" PrivateAssets="all" />
    <PackageReference Include="Readme" Version="1.2.1" PrivateAssets="all" />
    <ProjectReference Include="..\Inbox\Inbox.csproj" />
    <InternalsVisibleTo Include="Tests" />
  </ItemGroup>

  <!-- Build the current-OS whatsbox next to this project so project-reference copy lands it in the consumer outdir. -->
  <Target Name="BuildNativeWhatsBox" Condition="'$(RuntimeIdentifier)' == ''" 
          BeforeTargets="BeforeCompile;GetCopyToOutputDirectoryItems;AssignTargetPaths" 
          Inputs="$(NativeWhatsBoxSourceRoot)\**\*.go;$(NativeWhatsBoxSourceRoot)\go.mod;$(NativeWhatsBoxSourceRoot)\go.sum" 
          Outputs="$(InboxNativeBinary)">
    <MakeDir Directories="$([System.IO.Path]::GetDirectoryName($(InboxNativeBinary)))" />
    <Exec Command="go build -o &quot;$(InboxNativeBinary)&quot; ." 
          WorkingDirectory="$(NativeWhatsBoxSourceRoot)" 
          EnvironmentVariables="CGO_ENABLED=0" />
  </Target>

  <Target Name="BuildWhatsBoxRidNative" Condition="'$(RuntimeIdentifier)' != ''"
          Inputs="$(NativeWhatsBoxSourceRoot)\**\*.go;$(NativeWhatsBoxSourceRoot)\go.mod;$(NativeWhatsBoxSourceRoot)\go.sum"
          Outputs="$(InboxNativeBinary)">
    <Error Condition="'$(_WhatsBoxRidGoos)' == '' or '$(_WhatsBoxRidGoarch)' == ''"
           Text="Unsupported RuntimeIdentifier '$(RuntimeIdentifier)'. Supported: $(RuntimeIdentifiers)." />
    <MakeDir Directories="$([System.IO.Path]::GetDirectoryName($(InboxNativeBinary)))" />
    <Exec Command="go build -o &quot;$(InboxNativeBinary)&quot; ."
          WorkingDirectory="$(NativeWhatsBoxSourceRoot)"
          EnvironmentVariables="CGO_ENABLED=0;GOOS=$(_WhatsBoxRidGoos);GOARCH=$(_WhatsBoxRidGoarch)" />
  </Target>

  <Import Project="..\Inbox\build\Inbox.targets" Condition="'$(InboxTargetsImported)' != 'true'" />
</Project>
